# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# Langfuse 트레이스(선택). 공개키와 비밀키가 둘 다 있을 때만 기록한다. 주소는 가입한 리전 주소(미국 https://us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# 토스페이먼츠 결제위젯(크레딧 충전). 결제위젯 연동 문서의 문서용 테스트 키를 한 세트로 넣는다(test_gck / test_gsk).
# 클라이언트 키는 화면에 보내도 되고, 시크릿 키는 서버만 읽는다. 배포에서는 시크릿 키를 Secret Manager 로 연결한다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 처음 온 사용자에게 주는 무료 크레딧(기본 30)
FREE_CREDITS=
